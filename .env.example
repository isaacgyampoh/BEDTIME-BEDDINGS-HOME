# Frontend (Vite) — these are PUBLIC and shipped in the browser bundle.
# The anon key is safe to expose ONLY because Row Level Security restricts it.
# See supabase/migrations/015_security_hardening.sql.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# The following are EDGE FUNCTION SECRETS. They are NOT set here — set them with
#   supabase secrets set KEY=value
# and never commit real values (this file is a template only).
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY   # provided automatically by the platform
# PAYSTACK_SECRET_KEY         # REQUIRED: verifies the webhook HMAC signature
# PAYMENT_CALLBACK_SECRET     # REQUIRED: shared secret on NaloPay/Moolre/Hubtel callbacks
# NALOPAY_MERCHANT_ID
# NALOPAY_API_KEY
# NALOPAY_AUTH_HEADER
# MOOLRE_API_USER
# MOOLRE_API_KEY
# MOOLRE_API_PUBKEY
# MOOLRE_ACCOUNT_NUMBER
# MNOTIFY_KEY
# ARKESEL_API_KEY
# OPENAI_API_KEY
# WASENDER_API_KEY
