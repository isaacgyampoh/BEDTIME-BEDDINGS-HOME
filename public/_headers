# Fingerprinted by Vite — the filename changes when the contents do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must be re-fetched or a deploy never reaches a till that is open
# all day.
/index.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# The service worker decides when everything else updates. Cached, it would
# pin the old one in place.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/manifest.json
  Cache-Control: no-cache

# ---------------------------------------------------------------------------
# Security headers, added by the production audit on 25 November 2026.
#
# On /* rather than /index.html alone: the old block covered only the shell,
# so a direct path got none of them.
#
# Content-Security-Policy is REPORT-ONLY on purpose. The policy below is
# derived from every origin the built bundles actually reference, but it has
# not been exercised in a real browser against the live shop, and a CSP that
# is one origin short breaks the page outright. Report-only surfaces
# violations without that risk; switch it to the enforcing header once the
# reports come back clean.
#
# frame-ancestors IS enforced, because it only governs framing and cannot
# break the page itself. It is the modern replacement for X-Frame-Options,
# which is kept alongside it for older browsers.
# ---------------------------------------------------------------------------
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://bedtime-images.nanagyams99.workers.dev https://wqkgfvmvuljzexhevlnp.supabase.co https://api.qrserver.com https://ik.imagekit.io; connect-src 'self' https://api.bedtimehome.com https://bedtime-images.nanagyams99.workers.dev https://wqkgfvmvuljzexhevlnp.supabase.co wss://api.bedtimehome.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
